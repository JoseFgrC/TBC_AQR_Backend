DB_HOST=
DB_USER=rot
DB_PASSWORD=
DB_NAME=
DB_PORT=

# Servidor
PORT=3000
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173
# Proxy de confianza para leer la IP real del cliente (X-Forwarded-For), que usa el rate limit.
#  - Vacío (por defecto): no se confía en nadie; la IP es la de quien se conecta.
#  - Desarrollo con el proxy de Vite (frontend con VITE_API_URL vacío): TRUST_PROXY=loopback
#  - Producción con nginx/Apache en el MISMO servidor: TRUST_PROXY=loopback
#  - Producción con el proxy en OTRA máquina: su IP o subred, p. ej. TRUST_PROXY=10.0.0.5
#    (un número de saltos, p. ej. 1, solo si el puerto 3000 NO es accesible desde la red:
#    si lo fuera, cualquiera podría falsificar su IP conectándose directo).
#  - Nunca "true" (el servidor no arranca con ese valor).
TRUST_PROXY=
# URL pública de este backend (para las fotos guardadas en disco)
PUBLIC_URL=http://localhost:3000
# Aparece en la credencial y en los avisos de Telegram
SCHOOL_NAME=

# Telegram (crear el bot con @BotFather)
TELEGRAM_BOT_TOKEN=

# Cloudinary (opcional; sin esto las fotos se guardan en ./uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
